# Airtable
AIRTABLE_API_KEY=

# Google OAuth — used for BOTH Gmail (polling/labeling) and Calendar (booking
# blocks). One refresh token, obtained by signing in as the account that
# receives the Airbnb emails AND already manages the property calendars.
# See README "Gmail + Calendar setup".
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Optional overrides:
# GMAIL_SEARCH_QUERY=from:(automated@airbnb.com OR express@airbnb.com) subject:"Reservation confirmed"
# GMAIL_PROCESSED_LABEL=MonthStayz-Processed
# GMAIL_NEEDS_ATTENTION_LABEL=MonthStayz-Needs-Attention
# GMAIL_LOOKBACK_DAYS=3
# GMAIL_MAX_PER_RUN=8

# Shared secret Vercel Cron must send as "Authorization: Bearer <value>"
CRON_SECRET=

# Optional: cookie header from a logged-in Airbnb host session, used to look
# up the guest's phone number (see README). Omit to fall back to name-based
# CRM matching instead.
AIRBNB_SESSION_COOKIE=
