# Airtable
AIRTABLE_API_KEY=

# Gmail OAuth (see README "Gmail setup")
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Optional overrides:
# GMAIL_SEARCH_QUERY=from:(automated@airbnb.com OR express@airbnb.com) subject:"Reservation confirmed"
# GMAIL_PROCESSED_LABEL=MonthStayz-Processed
# GMAIL_NEEDS_ATTENTION_LABEL=MonthStayz-Needs-Attention

# Google Calendar service account (paste the full downloaded JSON key file content)
GOOGLE_SERVICE_ACCOUNT_KEY=

# Shared secret Vercel Cron must send as "Authorization: Bearer <value>"
CRON_SECRET=
